{
  "name": "adamward459-cc-plugin",
  "owner": { "name": "Pham Thanh Trung" },
  "plugins": [
    {
      "name": "test-cases",
      "source": "./",
      "description": "Turn a requirement and a branch into a test case file.",
      "skills": ["./skills/extract-test-cases"]
    },
    {
      "name": "qa-evidence",
      "source": "./",
      "description": "Record test evidence on web, iOS and Android, then publish it on a PR or MR.",
      "skills": ["./skills/record-evidence", "./skills/publish-evidence"],
      "mcpServers": {
        "chrome-devtools-rec": {
          "type": "stdio",
          "command": "npx",
          "args": ["-y", "chrome-devtools-mcp@latest", "--experimentalScreencast", "--isolated"]
        },
        "argent": {
          "type": "stdio",
          "command": "npx",
          "args": ["-y", "@swmansion/argent@latest", "mcp"]
        }
      }
    }
  ]
}
